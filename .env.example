# Leave blank for local development so Vite proxies /api to port 7777.
# Production (Render): set this on the *frontend* service at build time, then rebuild.
# No trailing slash. Must match the brain URL the browser will call.
# Example: VITE_API_BASE_URL=https://intelli-study-planner-brain.onrender.com
VITE_API_BASE_URL=

# Share link for the Microsoft Copilot study-plan agent. Falls back to general Copilot.
VITE_COPILOT_AGENT_URL=https://copilot.microsoft.com/
