# Local loopback URLs use Vite’s same-origin /api proxy during development.
# Set this to the HTTPS backend URL in production.
VITE_API_URL=http://localhost:7777
# Optional server-side override for the development proxy:
# COURSEO_API_PROXY_TARGET=http://127.0.0.1:7777

# Share link for the Microsoft Copilot study-plan agent. Falls back to general Copilot.
VITE_COPILOT_AGENT_URL=https://copilot.microsoft.com/
